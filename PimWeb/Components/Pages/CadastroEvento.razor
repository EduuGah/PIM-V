@page "/cadastro-evento"
@using PimWeb.Models
@using Npgsql
@inject IConfiguration Config

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">Agendar Novo Evento</h3>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nome do Evento</label>
                        <input type="text" class="form-control form-control-lg" @bind="evento.Nome" placeholder="Ex: Semana de Tecnologia" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Data de Início</label>
                            <input type="datetime-local" class="form-control" @bind="evento.DataInicio" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Data de Término</label>
                            <input type="datetime-local" class="form-control" @bind="evento.DataFim" />
                        </div>
                    </div>

                    <div class="mt-4">
                        <button class="btn btn-primary btn-lg w-100 shadow" @onclick="Salvar">
                            Confirmar Cadastro
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagem))
                    {
                        <div class="alert mt-4 alert-dismissible fade show @(mensagem.Contains("✅") ? "alert-success" : "alert-danger")" role="alert">
                            @mensagem
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Estas variáveis PRECISAM existir para o HTML lá de cima funcionar
    private PimWeb.Models.Evento evento = new PimWeb.Models.Evento { DataInicio = DateTime.Now, DataFim = DateTime.Now.AddDays(1) };
    private string mensagem = "";

    private void Salvar()
    {
        try 
        {
            evento.Validar();
            mensagem = "✅ Sucesso! Evento validado e salvo (Simulado).";
        }
        catch (Exception ex)
        {
            mensagem = "❌ Erro: " + ex.Message;
        }
    }
}