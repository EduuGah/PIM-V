@page "/"

<div class="container mt-5 text-center">
    <div class="jumbotron bg-light p-5 rounded shadow">
        <h1 class="display-4 text-primary">📊 Sistema de Gestão de Eventos</h1>
        <p class="lead">Bem-vindo ao PIM V - Organização e Controle de Atividades.</p>
        <hr class="my-4">
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card border-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Novos Registros</h5>
                        <p class="card-text">Cadastre eventos, participantes e atividades rapidamente.</p>
                        <a href="/cadastro-evento" class="btn btn-primary">Ir para Cadastro</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Relatórios</h5>
                        <p class="card-text">Visualize a lista completa de eventos e inscritos.</p>
                        <a href="/lista-eventos" class="btn btn-success">Ver Listagem</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>